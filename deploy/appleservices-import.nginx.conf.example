# Include inside the existing HTTPS server block. Replace the local upstream
# port if needed. Keep the app's Docker publish address on 127.0.0.1.
location = /api/integrations/appleservices/accounts {
    # Do not redirect credential-bearing POSTs or accept TLS 0-RTT replays.
    if ($scheme != https) { return 403; }
    if ($ssl_early_data = 1) { return 425; }
    if ($args != "") { return 400; }
    client_max_body_size 256k;
    client_body_buffer_size 256k;
    client_body_timeout 30s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 100s;
    proxy_read_timeout 100s;
    proxy_pass http://127.0.0.1:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # App emits only a fixed operation name and status. Nginx's default log
    # includes request URLs; disable endpoint logs to avoid query/header leaks.
    access_log off;
    error_log /dev/null crit;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
}
